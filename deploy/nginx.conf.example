# Include from http context; validate paths, certificate and PHP-FPM socket.
map $uri $wm_safe_uri {
    default $uri;
    ~^/reset-password/ /reset-password/redacted;
    ~^/invitations/ /invitations/redacted;
    ~^/email/verify/ /email/verify/redacted;
}
log_format wm_safe '$remote_addr [$time_local] "$request_method $wm_safe_uri $server_protocol" $status $body_bytes_sent $request_time';
server {
    listen 80;
    server_name work.example.com;
    return 301 https://work.example.com$request_uri;
}
server {
    listen 443 ssl;
    server_name work.example.com;
    root /srv/work-management/current/public;
    index index.php;
    ssl_certificate /etc/letsencrypt/live/work.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/work.example.com/privkey.pem;
    client_max_body_size 12m;
    # Authentication links contain secrets. Do not log query strings or reset/invitation path tokens.
    access_log /var/log/nginx/work-management.access.log wm_safe;
    location / { try_files $uri $uri/ /index.php?$query_string; }
    location ~ ^/index\.php(/|$) {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        fastcgi_param DOCUMENT_ROOT $realpath_root;
        fastcgi_pass unix:/run/php/php8.2-fpm.sock;
        fastcgi_hide_header X-Powered-By;
    }
    location ~ \.php$ { return 404; }
    location ~ /\.(?!well-known).* { deny all; }
}
