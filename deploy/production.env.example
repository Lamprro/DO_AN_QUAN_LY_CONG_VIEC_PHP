# Template only. Store the real .env outside Git with service-user-only permissions.
APP_NAME="Work Management"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://work.example.com
APP_LOCALE=vi
APP_FALLBACK_LOCALE=vi
REQUIRE_VERIFIED_EMAIL=true
# Comma-separated actual proxy addresses/CIDRs. Empty if Nginx terminates HTTPS directly.
TRUSTED_PROXIES=
LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=work_management
DB_USERNAME=work_management
DB_PASSWORD=
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
CACHE_STORE=redis
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
INVITATION_CACHE_STORE=redis
INVITATION_SEND_MAIL=true
INVITATION_TTL_MINUTES=1440
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=180
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Work Management"
AI_ENABLED=false
INTEGRATIONS_ENABLED=false
AI_PROVIDER=unconfigured
AI_MODEL=unconfigured
AI_ENDPOINT=
AI_API_KEY=
