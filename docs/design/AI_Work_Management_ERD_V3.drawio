        <mxCell id="github_logs_note" value="Một webhook/event mỗi dòng; push chứa commit trong payload. UQ(connection, delivery_id, project_id). Xác minh chữ ký trước xử lý. task_id gắn tối đa một task; nhiều mã task để chưa gắn. Cập nhật task idempotent." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=10;fontFamily=Arial;fontSize=13;fontColor=#334155;fillColor=#ffe4e6;" vertex="1" parent="t_github_logs">
          <mxGeometry x="0" y="528" width="560" height="85" as="geometry" />
        </mxCell>
        <mxCell id="t_user_settings" value="user_settings" style="swimlane;html=0;startSize=42;horizontal=1;collapsible=0;fontFamily=Arial;fontSize=19;fontStyle=1;align=left;spacingLeft=12;fillColor=#dbeafe;swimlaneFillColor=#ffffff;strokeColor=#2563eb;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="65" y="1390" width="560" height="262" as="geometry" />
        </mxCell>
        <mxCell id="user_settings.id" value="PK    id : uuid" style="text;html=0;align=left;verticalAlign=middle;fontFamily=Consolas;fontSize=13;spacingLeft=10;whiteSpace=wrap;" vertex="1" parent="t_user_settings">
          <mxGeometry x="0" y="42" width="560" height="27" as="geometry" />
        </mxCell>
        <mxCell id="user_settings.user_id" value="FK    user_id : uuid" style="text;html=0;align=left;verticalAlign=middle;fontFamily=Consolas;fontSize=13;spacingLeft=10;whiteSpace=wrap;" vertex="1" parent="t_user_settings">
          <mxGeometry x="0" y="69" width="560" height="27" as="geometry" />
        </mxCell>
        <mxCell id="user_settings.settings" value="      settings : json" style="text;html=0;align=left;verticalAlign=middle;fontFamily=Consolas;fontSize=13;spacingLeft=10;whiteSpace=wrap;" vertex="1" parent="t_user_settings">
          <mxGeometry x="0" y="96" width="560" height="27" as="geometry" />
