        <mxCell id="user_settings.created_at" value="      created_at : timestamp" style="text;html=0;align=left;verticalAlign=middle;fontFamily=Consolas;fontSize=13;spacingLeft=10;whiteSpace=wrap;" vertex="1" parent="t_user_settings">
