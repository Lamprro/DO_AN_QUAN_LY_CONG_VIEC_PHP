        </mxCell>
        <mxCell id="user_settings_note" value="UQ(user_id): một cấu hình/người. JSON chứa language, theme, notifications. Có schema kiểm tra/default BE. Không chứa quyền, token, log hay giờ làm mặc định." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=10;fontFamily=Arial;fontSize=13;fontColor=#334155;fillColor=#dbeafe;" vertex="1" parent="t_user_settings">
          <mxGeometry x="0" y="177" width="560" height="85" as="geometry" />
        </mxCell>
        <mxCell id="activity_help" value="COMMENT: trao đổi&#10;HISTORY: thay đổi dữ liệu task&#10;ATTACHMENT: metadata tệp&#10;&#10;Một dòng = một hoạt động.&#10;Task cha/con đều dùng cùng bảng tasks.&#10;&#10;Lịch NOTE/MEETING không cần task.&#10;Một TASK_BLOCK luôn gắn một task." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=20;fontColor=#1e293b;" vertex="1" parent="1">
          <mxGeometry x="790" y="1960" width="550" height="480" as="geometry" />
        </mxCell>
        <mxCell id="rules" value="QUY TẮC: một project có cây task nhiều cấp; goal là GROUP, mốc tùy chọn là MILESTONE. Parent/dependency không chu trình; không cộng trùng thời lượng cha/con.&#10;Calendar là nguồn lịch dự kiến; time_entries là giờ thực tế (tùy chọn). user_settings giữ cấu hình; notifications giữ từng thông báo và trạng thái gửi. Lời mời Redis có TTL.&#10;Plan theo phiên bản; duyệt có kiểm tra quyền và phiên bản nền. Mọi FK phải đúng workspace/project. Khung giờ mặc định do BE cấp, không có bảng working_hours." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=18;fontColor=#1e293b;" vertex="1" parent="1">
          <mxGeometry x="55" y="4850" width="3840" height="150" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
